<Window x:Class="BatteryGuardian.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Guardian Settings" 
        Height="200" Width="380" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="High Threshold (%):" 
                   VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="HighThresholdBox" 
                 Grid.Row="0" Grid.Column="1" 
                 Margin="0,0,0,10" Padding="4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Low Threshold (%):" 
                   VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="LowThresholdBox" 
                 Grid.Row="1" Grid.Column="1" 
                 Margin="0,0,0,10" Padding="4"/>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Save Settings" Width="120" Height="30" 
                HorizontalAlignment="Center" Click="SaveButton_Click"/>
    </Grid>
</Window>