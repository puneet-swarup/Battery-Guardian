<Window x:Class="BatteryGuardian.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Guardian Settings" 
        Height="300" Width="450" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="High Threshold (%):" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="HighThresholdBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="4"/>

        <!-- Row 1 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Low Threshold (%):" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="LowThresholdBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="4"/>

        <!-- Row 2: High Sound Path -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="High Alert Sound:" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="HighSoundBox" Grid.Row="2" Grid.Column="1" Margin="0,0,5,5" Padding="2"/>
        <Button x:Name="HighSoundBrowseBtn" Grid.Row="2" Grid.Column="2" Content="..." Width="30" Height="24" Click="HighSoundBrowse_Click" Margin="0,0,0,5"/>

        <!-- Row 3: Low Sound Path -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Low Alert Sound:" VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox x:Name="LowSoundBox" Grid.Row="3" Grid.Column="1" Margin="0,0,5,5" Padding="2"/>
        <Button x:Name="LowSoundBrowseBtn" Grid.Row="3" Grid.Column="2" Content="..." Width="30" Height="24" Click="LowSoundBrowse_Click" Margin="0,0,0,5"/>

        <!-- Row 5: Save Button -->
        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="Save Settings" Width="120" Height="30" HorizontalAlignment="Center" Click="SaveButton_Click"/>
    </Grid>
</Window>