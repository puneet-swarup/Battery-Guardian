<Window x:Class="BatteryGuardian.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="About Battery Guardian"
        Height="Auto"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Battery Guardian"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#111111"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="#555555"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="A lightweight utility that protects battery health by telling you when to plug in or unplug - and, with a Tuya smart plug, by switching the charger itself."
                       TextWrapping="Wrap"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#333333"
                       Margin="0,0,0,12"/>

            <TextBlock FontSize="12" Foreground="#444444" TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Text="&#x2022;  High and low charge alerts, spoken and shown as a toast"/><LineBreak/>
                <Run Text="&#x2022;  Repeat reminders until you act, plus snooze"/><LineBreak/>
                <Run Text="&#x2022;  Quiet hours and Focus Assist awareness"/><LineBreak/>
                <Run Text="&#x2022;  Battery health, charge history and wear trends"/><LineBreak/>
                <Run Text="&#x2022;  Charge limit on supported Lenovo, Dell and ASUS laptops"/><LineBreak/>
                <Run Text="&#x2022;  Optional: switch a Tuya smart plug at your thresholds, so the charger is cut even when you are away"/><LineBreak/>
            </TextBlock>

            <TextBlock HorizontalAlignment="Center" FontSize="12">
                <Hyperlink Click="TuyaLink_Click"
                           ToolTip="Opens a Google search in your browser">
                    What is a Tuya smart plug?
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="AuthorText"
                   Grid.Row="3"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="#555555"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="CopyrightText"
                   Grid.Row="4"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="#777777"
                   Margin="0,0,0,20"/>

        <TextBlock x:Name="LicenseText"
                   Grid.Row="5"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="#777777"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="GitHubButton"
                    Content="GitHub Repository"
                    Width="140"
                    Height="30"
                    FontSize="12"
                    Margin="0,0,8,0"
                    Click="GitHubButton_Click"/>
            <Button x:Name="ReleasesButton"
                    Content="Latest Release"
                    Width="140"
                    Height="30"
                    FontSize="12"
                    Click="ReleasesButton_Click"/>
        </StackPanel>

        <Button Grid.Row="7"
                Content="Close"
                Width="100"
                Height="30"
                FontSize="13"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"/>
    </Grid>
</Window>