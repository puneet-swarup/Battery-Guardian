<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>BatteryGuardian</RootNamespace>
		<AssemblyName>BatteryGuardian</AssemblyName>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<Platforms>AnyCPU</Platforms>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="System.Management" Version="9.0.0" />
		<PackageReference Include="System.Speech" Version="9.0.0" />
		<PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Exclude the test project folder so it doesn't get pulled into the main assembly -->
		<Compile Remove="BatteryGuardian.Tests\**" />
		<None Remove="BatteryGuardian.Tests\**" />
		<Page Remove="BatteryGuardian.Tests\**" />
		<ApplicationDefinition Remove="BatteryGuardian.Tests\**" />
		<Resource Remove="BatteryGuardian.Tests\**" />
		<EmbeddedResource Remove="BatteryGuardian.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
	</ItemGroup>

</Project>