<Window x:Class="BatteryGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="Battery Guardian"
        Height="Auto"
        Width="360"
        MinHeight="240"
        MinWidth="360"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Battery Guardian"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#222222"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock x:Name="BatteryPercentageText"
                   Grid.Row="1"
                   Text="Battery: --%"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#111111"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="ChargingStatusText"
                   Grid.Row="2"
                   Text="Status: Unknown"
                   FontSize="16"
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="EstimatedTimeText"
                   Grid.Row="3"
                   Text=""
                   FontSize="14"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="BatteryHealthText"
                   Grid.Row="4"
                   Text=""
                   FontSize="14"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <TextBlock x:Name="LastUpdatedText"
                   Grid.Row="5"
                   Text="Last updated: --"
                   FontSize="12"
                   Foreground="#777777"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RefreshButton"
                    Content="Refresh Now"
                    Width="130"
                    Height="34"
                    FontSize="14"
                    Click="RefreshButton_Click"/>
            <Button x:Name="SettingsButton"
                    Content="⚙  Settings"
                    Width="110"
                    Height="34"
                    FontSize="14"
                    Margin="10,0,0,0"
                    Click="SettingsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>